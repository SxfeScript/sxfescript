// A fixed-layout struct. Run it: sxn examples/velocity.sx
//
// An interface whose fields are all primitives -- i32, f32, f64, bool --
// describes a value rather than an object: declared field order, natural
// alignment, the same layout on every supported target. That is what code
// crossing into native memory needs, and it is also the one shape sxn does
// not allocate.

interface Transform {
    x: f32;
    y: f32;
    z: f32;
}

const dt: f32 = 0.016;

// Written in place, `pos` and `vel` never become objects at all. Each one is
// three ordinary locals, and the step below is arithmetic on six of them.
let mut pos: Transform = { x: 0.0, y: 10.0, z: 5.0 };
let vel: Transform = { x: 1.0, y: 0.0, z: 0.0 };
pos.x += vel.x * dt;
pos.y += vel.y * dt;
pos.z += vel.z * dt;
console.log(JSON.stringify(pos));

// The same step behind a function that borrows what it is given. `&mut`
// takes the owner exclusively, so the callee may write through it -- and a
// value something outside this scope can write to has to exist as an object,
// which is why these two are allocated where the two above were not. On an
// M4 that is 180 ns a step against 40.
const applyVelocity = (transform: &mut Transform, velocity: &Transform, dt: f32): void => {
    transform.x += velocity.x * dt;
    transform.y += velocity.y * dt;
    transform.z += velocity.z * dt;
};

let mut orbit: Transform = { x: 0.0, y: 10.0, z: 5.0 };
let drift: Transform = { x: 1.0, y: 0.0, z: 0.0 };
applyVelocity(&mut orbit, &drift, dt);
console.log(JSON.stringify(orbit));
