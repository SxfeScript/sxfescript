+/* rayact: cumulative JS_RunGC counters (voluntary and allocation-triggered
+   collections alike), for host frame profilers. */
+typedef struct JSGCStats {
+    uint64_t count;     /* collections since runtime creation */
+    uint64_t total_ns;  /* wall time inside JS_RunGC */
+    uint64_t decref_ns; /* mark pass 1 */
+    uint64_t scan_ns;   /* mark pass 2 */
+    uint64_t free_ns;   /* cycle-free pass */
+    uint64_t last_ns;   /* duration of the most recent collection */
+    uint64_t max_ns;    /* slowest single collection observed */
+} JSGCStats;
+JS_EXTERN void JS_GetGCStats(JSRuntime *rt, JSGCStats *stats);
+/* rayact: current tracked allocation total (the value js_trigger_gc compares
+   against the GC threshold) — cheap, no heap walk. */
+JS_EXTERN size_t JS_GetMallocSize(JSRuntime *rt);
 /* use 0 to disable maximum stack size check */
 JS_EXTERN void JS_SetMaxStackSize(JSRuntime *rt, size_t stack_size);
