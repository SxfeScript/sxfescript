     struct list_head tmp_obj_list; /* used during GC */
     JSGCPhaseEnum gc_phase : 8;
     size_t malloc_gc_threshold;
+    JSGCStats gc_stats; /* rayact: cumulative JS_RunGC counters */
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
     struct list_head string_list; /* list of JSString.link */
 #endif
@@ -7092,15 +7093,42 @@ static void gc_free_cycles(JSRuntime *rt)
 
 void JS_RunGC(JSRuntime *rt)
 {
+    /* rayact: per-pass timing so the host can attribute frame spikes to the
+       collector (and to the pass that dominates them) without sampling. */
+    uint64_t t0 = js__hrtime_ns(), t1, t2, t3;
+
     /* decrement the reference of the children of each object. mark =
        1 after this pass. */
     gc_decref(rt);
+    t1 = js__hrtime_ns();
 
     /* keep the GC objects with a non zero refcount and their childs */
     gc_scan(rt);
+    t2 = js__hrtime_ns();
 
     /* free the GC objects in a cycle */
     gc_free_cycles(rt);
+    t3 = js__hrtime_ns();
+
+    rt->gc_stats.count++;
+    rt->gc_stats.decref_ns += t1 - t0;
+    rt->gc_stats.scan_ns += t2 - t1;
+    rt->gc_stats.free_ns += t3 - t2;
+    rt->gc_stats.last_ns = t3 - t0;
+    if (t3 - t0 > rt->gc_stats.max_ns)
+        rt->gc_stats.max_ns = t3 - t0;
+    rt->gc_stats.total_ns += t3 - t0;
+}
+
+/* rayact: snapshot the cumulative GC counters (all zero at runtime birth). */
+void JS_GetGCStats(JSRuntime *rt, JSGCStats *stats)
+{
+    *stats = rt->gc_stats;
+}
+
+size_t JS_GetMallocSize(JSRuntime *rt)
+{
+    return rt->malloc_state.malloc_size;
 }
 
